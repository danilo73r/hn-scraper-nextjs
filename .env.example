# Local development settings. Copy to .env.local.
POSTGRES_USER=hn_crawler
POSTGRES_PASSWORD=hn_crawler
POSTGRES_DB=hn_crawler
DATABASE_URL=postgresql://hn_crawler:hn_crawler@localhost:5432/hn_crawler

# Cache ages in seconds; read once per process. Maximum must exceed freshness.
CACHE_FRESH_SECONDS=60
CACHE_MAX_AGE_SECONDS=600

# Maximum wait for the shared collection; persistence is awaited afterwards.
REQUEST_TIMEOUT_SECONDS=10
